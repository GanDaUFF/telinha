{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telinha",
  "main": "worker.js",
  "compatibility_date": "2026-05-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
